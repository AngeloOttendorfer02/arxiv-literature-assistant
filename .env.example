# Copy to .env and adjust. .env is gitignored, never commit it.

# 1 = no database, model or guardrails needed. 0 = real components only.
USE_MOCKS=1

# With USE_MOCKS=1: components that use the real code, e.g. plan,retrieve
REAL_COMPONENTS=

# Required with USE_MOCKS=0. App uses the read-only role, localhost only.
DATABASE_URL=postgresql://app:app@localhost:5432/scilitrag

# Required with USE_MOCKS=0. OpenAI-compatible endpoint, local Ollama by default.
LLM_BASE_URL=http://localhost:11434/v1

# Required with USE_MOCKS=0. Ollama tag; final choice is open (O6).
LLM_MODEL=qwen2.5:3b-instruct-q4_K_M

# Hugging Face ID of the embedding model.
EMBED_MODEL=BAAI/bge-base-en-v1.5

# Folder for large local data (HF cache, datasets), used by scripts/download_data.py.
DATA_DIR=data

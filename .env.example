# Copy to .env and adjust. .env is gitignored, never commit it.

# 1 = no database, model or guardrails needed. 0 = real components only.
USE_MOCKS=1

# With USE_MOCKS=1: components that use the real code, e.g. plan,retrieve
REAL_COMPONENTS=

# Database container (docker compose). Local only; the port is bound to 127.0.0.1.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=scilitrag
DB_PORT=5432
API_PORT=8000
UI_PORT=8501

# D-06 roles, created explicitly with docker/db/roles.sql after schema.sql.
# Names: lowercase letters, digits, underscores; start with a letter or underscore.
# Choose different strong passwords using only letters, digits, and . _ ~ -.
APP_DB_USER=app
APP_DB_PASSWORD=change-me-app
INGEST_DB_USER=ingest
INGEST_DB_PASSWORD=change-me-ingest

# 127.0.0.1, not localhost: on Windows every localhost connection first waits 5 s for IPv6.
# Local API: SELECT only. Compose uses the same credentials with host db instead.
DATABASE_URL=postgresql://${APP_DB_USER}:${APP_DB_PASSWORD}@127.0.0.1:${DB_PORT}/${POSTGRES_DB}
# Local data loaders: SELECT, INSERT, UPDATE, DELETE; never use this for the API.
INGEST_DATABASE_URL=postgresql://${INGEST_DB_USER}:${INGEST_DB_PASSWORD}@127.0.0.1:${DB_PORT}/${POSTGRES_DB}

# Required with USE_MOCKS=0. OpenAI-compatible endpoint, local Ollama by default.
LLM_BASE_URL=http://localhost:11434/v1

# Required with USE_MOCKS=0. Ollama tag; small CPU model for development, final choice is open (O6).
LLM_MODEL=qwen3.5:2b-mtp-q4_K_M

# Time limit for one query in seconds; afterwards the API sends an error event with code "timeout".
REQUEST_TIMEOUT_S=120

# Folder for the request log (requests.jsonl). Empty: log to stdout only.
LOG_DIR=logs

# Where the Streamlit UI reaches the API.
API_URL=http://localhost:8000

# Hugging Face ID of the embedding model.
EMBED_MODEL=ibm-granite/granite-embedding-english-r2

# Folder for large local data (HF cache, datasets), used by scripts/download_data.py.
DATA_DIR=data

# Hugging Face read token (huggingface.co/settings/tokens). Faster downloads; needed for gated models.
HF_TOKEN=

# WP2 model request policy.
LLM_MAX_RETRIES=1
LLM_RETRY_BACKOFF_S=0.2
LLM_MAX_OUTPUT_TOKENS=1024

# Includes serialized instructions, question and evidence metadata; measured in characters.
CONTEXT_CHAR_BUDGET=16000
EVIDENCE_ITEM_CHAR_LIMIT=2400

# Maximum pending model-output segment before a complete sentence is available.
MAX_SENTENCE_BUFFER_CHARS=32768

# Prompt Guard 2 malicious score from which a query is refused as injection (0 to 1, S-04).
# Provisional; choose on the tuning set (S-13).
PROMPT_GUARD_THRESHOLD=0.5

# Same model on retrieved chunks and abstracts (S-05); a source at or above this score is dropped.
# Papers about prompt injection can score high, so this is tuned separately in S-13.
EVIDENCE_GUARD_THRESHOLD=0.5

# Sentence validation (S-10): NLI cross-encoder and the probabilities from which a cited source
# counts as supporting (entailment) or contradicting a sentence. Provisional; tuned in S-13.
NLI_MODEL=dleemiller/ModernCE-large-nli
NLI_ENTAILMENT_THRESHOLD=0.5
NLI_CONTRADICTION_THRESHOLD=0.5
